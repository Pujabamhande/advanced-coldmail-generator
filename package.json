{



   "scripts": {

    "install": "npm --prefix backend install && npm --prefix frontend\\GenAI install",
    "dev:server": "npm --prefix backend run dev",
    "dev:client": "npm --prefix frontend\\GenAI run dev",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix frontend\\GenAI run build"


  },
  "dependencies": {
    "concurrently": "^10.0.7"
  }
}


 